<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pursuit.ene-equipment</string>

    <!-- Asset inventory refresh. Open data, no API key needed. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/trevorrukwava/Pursuit A/nyc-hackathon/poller/run.py</string>
        <string>sync-equipment</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/trevorrukwava/Pursuit A/nyc-hackathon/poller</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>17</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/trevorrukwava/Pursuit A/nyc-hackathon/poller/data/equipment.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/trevorrukwava/Pursuit A/nyc-hackathon/poller/data/equipment.err</string>
</dict>
</plist>
