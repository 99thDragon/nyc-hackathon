<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pursuit.ene-poller</string>

    <!-- System python: a path that never moves. The code is stdlib-only and
         the full test suite passes on 3.9.6. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/trevorrukwava/Pursuit A/nyc-hackathon/poller/run.py</string>
        <string>poll</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/trevorrukwava/Pursuit A/nyc-hackathon/poller</string>

    <!-- The API key is NOT here. run.py reads it from /Users/trevorrukwava/Pursuit A/nyc-hackathon/poller/.env (chmod 600)
         so it is not sitting in world-readable XML under ~/Library. -->

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/trevorrukwava/Pursuit A/nyc-hackathon/poller/data/poll.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/trevorrukwava/Pursuit A/nyc-hackathon/poller/data/poll.err</string>
</dict>
</plist>
